<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popupRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@android:color/transparent">

    <!-- 1) A vertical layout for the background bubble (rectangle + tail) -->
    <LinearLayout
        android:id="@+id/layoutBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- The rectangle confetti banner -->
        <ImageView
            android:id="@+id/imageBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:src="@drawable/banner" />

        <!-- The triangle tail at the bottom center -->
        <ImageView
            android:id="@+id/imageTail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/tail_banner"
            android:adjustViewBounds="true"
            android:scaleType="fitXY" />
    </LinearLayout>

    <!-- 2) Overlay content on top of the banner -->
    <!--    Use match_parent so it overlaps the rectangle portion. -->
    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="382dp"
        android:layout_height="425dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Circular badge area -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/circle_gray"
            android:gravity="center">

            <!-- If you have an ImageView badge, place it here.
                 Otherwise, a TextView for placeholder text: -->
            <TextView
                android:id="@+id/textBadgeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textSize="16sp" />
        </FrameLayout>

        <!-- "Well done!" text -->
        <TextView
            android:id="@+id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Well done!"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Sub-message -->
        <TextView
            android:id="@+id/textSubMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="You've earned the [Badge Name] for tracking your travel, keep making sustainable choices!"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <!-- Continue button -->
        <Button
            android:id="@+id/buttonContinue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="CONTINUE"
            android:textColor="@android:color/white" />

    </LinearLayout>
</FrameLayout>
