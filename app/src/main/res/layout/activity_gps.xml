<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".GPS">

    <!-- 1) Curved header image at the top -->
    <ImageView
        android:id="@+id/imageHeader"
        android:layout_width="419dp"
        android:layout_height="190dp"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:src="@drawable/header_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2) Back arrow on top-left of the header -->
    <ImageView
        android:id="@+id/imageBackArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Back Arrow"
        android:src="@drawable/arrow_back"
        app:layout_constraintStart_toStartOf="@id/imageHeader"
        app:layout_constraintTop_toTopOf="@id/imageHeader" />

    <!-- 3) Main title, centered horizontally on the header (using sp) -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TRACK YOUR DISTANCE"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="@id/imageHeader"
        app:layout_constraintStart_toStartOf="@id/imageHeader"
        app:layout_constraintEnd_toEndOf="@id/imageHeader" />

    <!-- 4) Subtitle, also centered, below the main title (using sp) -->
    <TextView
        android:id="@+id/textSubtitle"
        android:layout_width="261dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Small choices, big impact! Choose green travel and help the planet!"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/imageHeader"
        app:layout_constraintStart_toStartOf="@id/imageHeader"
        app:layout_constraintTop_toBottomOf="@id/textTitle" />

    <!-- 5) Progress bar row: walking icon, horizontal bar, badge icon -->
    <LinearLayout
        android:id="@+id/progressBarRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/imageHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imageWalking"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Walking Icon"
            android:src="@drawable/black_walk_icon" />

        <ProgressBar
            android:id="@+id/progressSteps"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:indeterminateOnly="false"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/progress_horizontal" />

        <!-- Badge icon (fixed size, stretchable) -->
        <ImageView
            android:id="@+id/imageBadge"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Badge Icon"
            android:src="@drawable/goal_check"
            android:adjustViewBounds="true"
            android:scaleType="fitXY" />
    </LinearLayout>

    <!-- 6) Card-like container for distance/time/steps, carbon emission, and button -->
    <LinearLayout
        android:id="@+id/cardStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBarRow">

        <!-- Row for Distance + Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Left (Distance) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textDistanceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISTANCE (km)"
                    android:textSize="35px"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDistanceValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textSize="45px" />
            </LinearLayout>

            <!-- Right (Time) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textTimeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIME"
                    android:textSize="35px"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textTimeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="45px" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row for displaying step count + button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textStepsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEPS"
                android:textSize="35px"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textStepsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0"
                android:textSize="45px" />

            <!-- A spacer to push the button to the right -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Single button to Start → Pause → Resume -->
            <Button
                android:id="@+id/buttonStartStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_rounded_rectangle"
                android:text="START"
                android:textColor="@android:color/white"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Horizontal row for CO₂ text (smaller) + Spinner -->
        <LinearLayout
            android:id="@+id/co2Layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/textCarbonEmission"
                android:layout_width="188dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Walking saved 0.00 kg CO₂ vs. using a car."
                android:textColor="@android:color/black"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerTransportMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 7) Bottom section (map) occupies remaining space below cardStats -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/cardStats"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
